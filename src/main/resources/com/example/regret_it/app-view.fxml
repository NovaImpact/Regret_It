<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800" prefWidth="1200" style="-fx-background-color: rgb(221, 221, 221);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.regret_it.RegretController">

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: rgb(0, 126, 217); -fx-padding: 10 24 10 24;">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24;" text="😬😬😬" />
                <VBox spacing="0">
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20;" text="RegretIt" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 10;" text="Community Through Regrets" />
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <StackPane>
                <Button fx:id="bellButton" onAction="#onBellClicked" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;" text="🔔" />
                <Circle fill="RED" radius="7" StackPane.alignment="TOP_RIGHT" />
            </StackPane>

            <ComboBox fx:id="userDropdown" prefWidth="150" promptText="Current User" style="-fx-background-color: white; -fx-background-radius: 5;" />

            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.1); -fx-padding: 5 12; -fx-background-radius: 20;">
                <Label style="-fx-text-fill: white;" text="👤" />
                <Label fx:id="usernameLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Active User" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200" spacing="10" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="20" left="15" right="15" top="20" /></padding>

            <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11;" text="FILTER BY" />
            <ComboBox fx:id="filterBox" onAction="#FilterThreads" prefWidth="170" promptText="Sort Order" style="-fx-background-color: #f4f4f4;" />

            <Region prefHeight="10" />

            <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11;" text="TAGS" />
            <VBox spacing="5">
                <Button onAction="#FilterThreads" style="-fx-background-color: transparent;" text="#LifeChoices" />
                <Button onAction="#FilterThreads" style="-fx-background-color: transparent;" text="#Relationships" />
                <Button onAction="#FilterThreads" style="-fx-background-color: transparent;" text="#Money" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="5" style="-fx-background-color: #fff0f0; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #ffcccc;">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #c00;" text="⚠ CAUTION" />
                <Label style="-fx-font-size: 11;" text="DON'T POST A MESSAGE YOU WILL END UP REGRETTING!!" wrapText="true" />
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane>

            <Button onAction="#onOpenPostPopup" style="-fx-background-color: rgb(0, 193, 94); -fx-text-fill: white; -fx-font-size: 30; -fx-background-radius: 50; -fx-pref-width: 60; -fx-pref-height: 60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 4);" text="+" StackPane.alignment="BOTTOM_RIGHT">
                <StackPane.margin><Insets bottom="30" right="30" /></StackPane.margin>
            </Button>

            <StackPane fx:id="postPopupOverlay" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
                <VBox maxHeight="500" maxWidth="500" spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Confess a Regret" />
                    <TextField fx:id="postHeadingField" promptText="Heading" />
                    <TextArea fx:id="postBodyField" promptText="Message content..." wrapText="true" VBox.vgrow="ALWAYS" />

                    <HBox spacing="10">
                        <Button onAction="#UploadMedia" style="-fx-background-color: #eee;" text="📁 Upload Media" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onClosePost" style="-fx-background-color: #ccc;" text="Cancel" />
                        <Button onAction="#PostThread" style="-fx-background-color: rgb(0, 193, 94); -fx-text-fill: white; -fx-font-weight: bold;" text="Post Thread" />
                    </HBox>
                </VBox>
            </StackPane>

            <StackPane fx:id="threadPopupOverlay" style="-fx-background-color: rgba(0,0,0,0.7);" visible="false">
                <VBox maxHeight="600" maxWidth="700" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <HBox style="-fx-background-color: rgb(0, 126, 217); -fx-padding: 10; -fx-background-radius: 10 10 0 0;">
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Discussion" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#CloseThread" style="-fx-background-color: transparent; -fx-text-fill: white;" text="✕" />
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <VBox fx:id="commentsContainer" spacing="10" style="-fx-padding: 20;" />
                    </ScrollPane>
                    <HBox spacing="10" style="-fx-padding: 15; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
                        <TextField fx:id="commentField" promptText="Write a comment..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#Comment" style="-fx-background-color: rgb(0, 126, 217); -fx-text-fill: white;" text="Comment" />
                    </HBox>
                </VBox>
            </StackPane>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="threadContainer" spacing="15">
                    <padding><Insets bottom="80" left="20" right="20" top="20" /></padding>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                        <HBox spacing="10">
                            <VBox alignment="TOP_CENTER" prefWidth="40" spacing="5">
                                <Button onAction="#Upvote" style="-fx-background-color: transparent; -fx-text-fill: rgb(0, 193, 94); -fx-font-weight: bold;" text="▲" />
                                <Label fx:id="voteCountLabel" style="-fx-font-weight: bold;" text="847" />
                                <Button onAction="#Downvote" style="-fx-background-color: transparent; -fx-text-fill: #ff4444; -fx-font-weight: bold;" text="▼" />
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: rgb(0, 126, 217);" text="u/regretter1" />
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 11;" text="• 2 hours ago" />
                                </HBox>
                                <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="I bought a truck I can't afford." />
                                <Label text="Payments are $900 a month and I only make $2500. What was I thinking?" wrapText="true" />
                                <HBox spacing="10">
                                    <Button onAction="#OpenThread" style="-fx-background-color: rgb(0, 126, 217); -fx-text-fill: white;" text="💬 Open Thread" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

    <right>
        <VBox prefWidth="220" spacing="15" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;">
            <padding><Insets bottom="20" left="15" right="15" top="20" /></padding>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #666;" text="🏆 RANKINGS" />
            <VBox fx:id="rankingsBox" spacing="8">
            </VBox>
        </VBox>
    </right>

</BorderPane>
